# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# docker-compose loads .env automatically. Every value here has a sane default
# in docker-compose.yml, so the stack also runs without a .env.

# --- Host ports (change if they clash with something already running) ---
KAFKA_EXTERNAL_PORT=9094
MONGO_PORT=27017
REDIS_PORT=6379
CATALOG_PORT=8081
CUSTOMER_PORT=8082
WORKER_PORT=8083

# --- Kafka topics and consumer group ---
KAFKA_TOPIC=orders
KAFKA_DLT_TOPIC=orders.DLT
KAFKA_GROUP_ID=order-worker

# --- MongoDB database name ---
MONGO_DB=orders

# --- Worker retry policy (consumer-level, for lock contention) ---
WORKER_MAX_RETRIES=3
