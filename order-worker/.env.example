# Config del order-worker (para correrlo standalone, p. ej. ./mvnw spring-boot:run
# contra infraestructura local). Con Docker Compose se inyectan solas.

# Infraestructura
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MONGODB_URI=mongodb://localhost:27017/orders
REDIS_URL=redis://localhost:6379

# APIs de enriquecimiento (servicios Go)
CATALOG_BASE_URL=http://localhost:8081
CUSTOMER_BASE_URL=http://localhost:8082
ENRICH_REQUEST_TIMEOUT=2s

# Kafka
KAFKA_TOPIC=orders
KAFKA_DLT_TOPIC=orders.DLT
KAFKA_GROUP_ID=order-worker
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF=200ms

# Resiliencia (retry + circuit breaker de las llamadas HTTP)
ENRICH_RETRY_MAX_ATTEMPTS=3
ENRICH_RETRY_BACKOFF=200ms
ENRICH_RETRY_MULTIPLIER=2.0
ENRICH_BREAKER_WINDOW=20
ENRICH_BREAKER_FAILURE_RATE=50
ENRICH_BREAKER_WAIT_OPEN=10s
ENRICH_BREAKER_SLOW_CALL=2s